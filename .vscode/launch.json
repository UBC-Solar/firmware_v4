{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "J-Link + SWO (active CMake target)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "device": "STM32F103RC",
      "interface": "swd",
      "runToEntryPoint": "main",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 20
      },
      "swoConfig": {
        "enabled": true,
        "source": "probe",
        "cpuFrequency": 72000000,
        "swoFrequency": 2000000,
        "decoders": [
          {
            "type": "console",
            "label": "ITM",
            "port": 0,
            "encoding": "ascii",
            "showOnStartup": true
          }
        ]
      }
    },
    {
      "name": "ST-LINK (active ELF path)",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "deviceName": "STM32F103RCT6",
      "deviceCore": "Cortex-M3",
      "cwd": "${workspaceFolder}",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${command:cmake.launchTargetPath}",
        }
      ]
    },
    {
      "name": "J-LINK NO SWO (active ELF path)",
      "type": "jlinkgdbtarget",
      "request": "launch",
      "deviceName": "STM32F103RCT6",
      "deviceCore": "Cortex-M3",
      "cwd": "${workspaceFolder}",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${command:cmake.launchTargetPath}",
        }
      ]
    },
    {
      // SIL: runs the open test file with pytest --gdb. The test loads its board in Renode and
      // waits for the firmware debugger before running any firmware.
      "name": "SIL: debug test (Python)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/sim/.venv/bin/python",
      "cwd": "${workspaceFolder}/sim",
      "args": ["${file}", "--gdb", "-s"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // SIL: attaches to Renode's GDB server, started by `pytest --gdb`.
      // sim/.gdb-target.elf is a link to the ELF that test loaded (any board, Debug or Release).
      // Renode doesn't understand cortex-debug's default `monitor reset halt`, hence
      // overrideLaunchCommands; "launch" (not "attach") so runToEntryPoint is honoured.
      "name": "SIL: attach firmware (Renode)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3333",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/sim/.gdb-target.elf",
      "overrideLaunchCommands": [],
      "runToEntryPoint": "main",
      "preLaunchTask": "SIL: wait for Renode GDB server"
    }
  ],
  "compounds": [
    {
      // Open a test file in sim/<board>/, pick this, F5: debugs the test and the board's firmware.
      "name": "SIL: debug test + firmware",
      "configurations": ["SIL: debug test (Python)", "SIL: attach firmware (Renode)"],
      "stopAll": true
    }
  ]
}