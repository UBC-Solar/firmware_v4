{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "J-Link + SWO (active CMake target)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "device": "STM32F103RC",
      "interface": "swd",
      "runToEntryPoint": "main",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 20
      },
      "swoConfig": {
        "enabled": true,
        "source": "probe",
        "cpuFrequency": 72000000,
        "swoFrequency": 2000000,
        "decoders": [
          {
            "type": "console",
            "label": "ITM",
            "port": 0,
            "encoding": "ascii",
            "showOnStartup": true
          }
        ]
      }
    },
    {
      "name": "ST-LINK (active ELF path)",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "deviceName": "STM32F103RCT6",
      "deviceCore": "Cortex-M3",
      "cwd": "${workspaceFolder}",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${command:cmake.launchTargetPath}",
        }
      ]
    },
    {
      "name": "J-LINK NO SWO (active ELF path)",
      "type": "jlinkgdbtarget",
      "request": "launch",
      "deviceName": "STM32F103RCT6",
      "deviceCore": "Cortex-M3",
      "cwd": "${workspaceFolder}",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${command:cmake.launchTargetPath}",
        }
      ]
    },
    {
      // SIL: runs the open test file with pytest --gdb. The test loads its board in Renode and
      // waits for the firmware debugger before running any firmware.
      "name": "SIL: debug test (Python)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/sim/.venv/bin/python",
      "cwd": "${workspaceFolder}/sim",
      "args": ["${file}", "-k", "${input:silTest}", "--gdb", "-s"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": { "hidden": true }
    },
    {
      "name": "SIL: attach firmware (Renode)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3333",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/sim/.gdb-target.elf",
      "overrideLaunchCommands": [],
      "runToEntryPoint": "main",
      "preLaunchTask": "SIL: wait for Renode GDB server",
      "presentation": { "hidden": true }
    }
  ],
  "compounds": [
    {
      "name": "SIL: Debug Test (current file)",
      "configurations": ["SIL: debug test (Python)", "SIL: attach firmware (Renode)"],
      "stopAll": true,
      "presentation": { "group": "SIL", "order": 1 }
    }
  ],
  "inputs": [
    {
      "id": "silTest",
      "type": "promptString",
      "description": "Test to debug: its function name (or a unique part of it), e.g. test_every_rtos_task_runs"
    }
  ]
}