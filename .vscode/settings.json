{
  "cmake.sourceDirectory": [
    "${workspaceFolder}/firmware/components/tel",
    "${workspaceFolder}/firmware/components/mdi",
    "${workspaceFolder}/firmware/components/nucleo_f103rb",
    "${workspaceFolder}/firmware/components/drd",
    "${workspaceFolder}/firmware/components/hvc",
    "${workspaceFolder}/firmware/components/mst",
    "${workspaceFolder}/firmware/components/str",
  ],
  "cmake.buildDirectory": "${sourceDirectory}/build",
  "cmake.cmakePath": "cube-cmake",
  "cmake.configureArgs": [
    "-DCMAKE_COMMAND=cube-cmake",
    "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "-DSUNLITE_OTA_PUBLIC_KEY_FILE=/Users/tonychen/.config/sunlite/firmware-ed25519.pub",
    "-DSUNLITE_OTA_FIRMWARE_VERSION=3",
    "-DSUNLITE_OTA_DISPLAY_VERSION=3.0.0",
    "-DTEL_OTA_ENABLE_TEST_BYPASS=ON"
  ],
  "cmake.preferredGenerators": [
    "Ninja"
  ],
  "editor.formatOnSave": false,
  "[c]": {
    "editor.defaultFormatter": "STMicroelectronics.stm32cube-ide-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "STMicroelectronics.stm32cube-ide-clangd"
  },
  "stm32cube-ide-clangd.path": "cube",
  "stm32cube-ide-clangd.arguments": [
    "starm-clangd",
    "--clang-tidy",
    "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/13.3.1+st.9/bin/arm-none-eabi-gcc",
    "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/13.3.1+st.9/bin/arm-none-eabi-g++"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.organizeImports": "never"
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "sunliteOta.host": "raspberrypi.local",
  "sunliteOta.user": "tonychen",
  "sunliteOta.gatewayExecutable": "/home/tonychen/sunlite/.venv/bin/sunlite-ota",
  "sunliteOta.privateKeyPath": "/Users/tonychen/.config/sunlite/firmware-ed25519-private.pem",
  "sunliteOta.objcopyPath": "/Users/tonychen/Library/Application Support/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-objcopy",
  "sunliteOta.automaticVersioning": true
}
