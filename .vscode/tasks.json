{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "J-Link Release Flash",
            "type": "shell",
            "command": "sh",
            "args": [
                "-c",
                "printf \"erase 0x08000000 0x0803FFFF\\nloadfile ${command:cmake.launchTargetPath}\\nr\\ng\\nq\\n\" | JLinkExe -device STM32F103RC -if SWD -speed 4000"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false
            }
        },
        {
            // Runs before "SIL: attach firmware (Renode)". Waits (up to 60 s) until `pytest --gdb`
            // has Renode's GDB server listening on 3333. Checks with ss instead of connecting:
            // a connection would count as the debugger attaching.
            "label": "SIL: wait for Renode GDB server",
            "type": "shell",
            "command": "timeout 60 sh -c 'until ss -ltn | grep -q \":3333 \"; do sleep 0.2; done'",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "showReuseMessage": false
            }
        }
    ]
}