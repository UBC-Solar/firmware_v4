# Run at build time by git_version.cmake: cmake -DSOURCE_DIR=<dir in repo> -DOUTPUT=<header> -P
#
# If git isn't available (no git, not a checkout, "dubious ownership" in a container, ...) the
# hash is 0 so the board still builds.

set(hash "00000000")
set(dirty 0)

find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
        WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE full_hash
        RESULT_VARIABLE rev_parse_result
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(rev_parse_result EQUAL 0)
        string(SUBSTRING "${full_hash}" 0 8 hash)

        # Tracked files only: untracked files (build dirs, scratch notes) don't make a build dirty.
        execute_process(
            COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
            WORKING_DIRECTORY ${SOURCE_DIR}
            OUTPUT_VARIABLE status_output
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        if(NOT status_output STREQUAL "")
            set(dirty 1)
        endif()
    endif()
endif()

set(content "/* Generated by firmware/common/git_version/git_version_gen.cmake. Do not edit. */
#ifndef __GIT_VERSION_GENERATED_H__
#define __GIT_VERSION_GENERATED_H__

#define GIT_VERSION_HASH 0x${hash}U
#define GIT_VERSION_DIRTY ${dirty}U

#endif /* __GIT_VERSION_GENERATED_H__ */
")

set(old_content "")
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} old_content)
endif()
if(NOT old_content STREQUAL content)
    file(WRITE ${OUTPUT} "${content}")
    message(STATUS "git_version: ${hash} dirty=${dirty}")
endif()
