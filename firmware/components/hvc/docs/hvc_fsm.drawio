        <mxCell id="v34" parent="1" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#6B7280;" value="&lt;b&gt;HOW A FAULT IS HANDLED&lt;/b&gt;" vertex="1">
          <mxGeometry height="18" width="300" x="1176" y="490" as="geometry" />
        </mxCell>
        <mxCell id="v35" parent="1" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#1F2937;verticalAlign=top;spacingLeft=0;" value="- Each pass, FsmRun() checks every fault flag before running the state.&lt;br&gt;- Interrupts only set a flag; the switch to FAULT happens on the next pass.&lt;br&gt;- Flags never clear: only an HVC reset clears them.&lt;br&gt;- Every flag is sent over CAN, one bit each." vertex="1">
