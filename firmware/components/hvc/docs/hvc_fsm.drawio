        <mxCell id="v6" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#7C9CD6;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#3B5BA9&#39;&gt;&lt;b&gt;0. RESET&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Check fault pins, put every output in its safe state&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="175" as="geometry" />
        </mxCell>
        <mxCell id="v7" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#7C9CD6;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#3B5BA9&#39;&gt;&lt;b&gt;1. TEL_STARTUP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Turn DIST on, wait for TEL&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="280" as="geometry" />
        </mxCell>
        <mxCell id="v8" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#7C9CD6;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#3B5BA9&#39;&gt;&lt;b&gt;2. MST_HANDSHAKE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Wait for MST&#39;s startup pulse on MASTERBOARD_FAULT&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="385" as="geometry" />
        </mxCell>
        <mxCell id="v9" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#7C9CD6;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#3B5BA9&#39;&gt;&lt;b&gt;3. MST_STATUS_CHECK&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Wait for a healthy MST status message&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="490" as="geometry" />
        </mxCell>
        <mxCell id="v10" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#7C9CD6;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#3B5BA9&#39;&gt;&lt;b&gt;4. FANS_POWERUP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Fans on at 100 %&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="595" as="geometry" />
        </mxCell>
        <mxCell id="v11" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E0A452;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#A86400&#39;&gt;&lt;b&gt;5. HV_CONNECT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Close NEG, then POS&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="700" as="geometry" />
        </mxCell>
        <mxCell id="v12" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E0A452;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#A86400&#39;&gt;&lt;b&gt;6. OPEN_DISCHARGE_RELAY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Pulse the latching discharge relay open&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="805" as="geometry" />
        </mxCell>
