          <mxGeometry height="56" width="320" x="90" y="910" as="geometry" />
        </mxCell>
        <mxCell id="v14" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E0A452;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#A86400&#39;&gt;&lt;b&gt;8. MPPT_PRECHARGE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Close MPPT precharge contactor&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="1015" as="geometry" />
        </mxCell>
