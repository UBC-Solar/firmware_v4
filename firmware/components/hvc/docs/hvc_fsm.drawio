          <mxGeometry height="56" width="320" x="90" y="1225" as="geometry" />
        </mxCell>
        <mxCell id="v17" parent="1" style="fontFamily=Helvetica;rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#7C9CD6;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;font style=&#39;font-size:12px&#39; color=&#39;#3B5BA9&#39;&gt;&lt;b&gt;11. LV_POWERUP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39; color=&#39;#6B7280&#39;&gt;Ask DIST to power the LV boards (every 500 ms)&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="320" x="90" y="1330" as="geometry" />
        </mxCell>
